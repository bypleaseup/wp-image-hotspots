{
    "name": "pleaseup/image-hotspots-tool",
    "description": "Add drag & drop hotspots to images from the Media Library, Gutenberg galleries, and ACF fields.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "homepage": "https://by.pleaseup.com/",
    "authors": [
        {
            "name": "by.pleaseup.com",
            "homepage": "https://by.pleaseup.com/",
            "role": "Maintainer"
        }
    ],
    "require": {
        "php": ">=7.4",
        "composer/installers": "^1.0 || ^2.0"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^1.11",
        "szepeviktor/phpstan-wordpress": "^1.3",
        "phpunit/phpunit": "^9.6",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Pleaseup\\WPImageHotspots\\": "includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pleaseup\\WPImageHotspots\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "composer/installers": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --memory-limit=512M",
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage",
        "compat": "phpcs --standard=PHPCompatibilityWP --runtime-set testVersion 7.4-",
        "qa": [
            "@lint",
            "@analyse",
            "@test"
        ]
    }
}
